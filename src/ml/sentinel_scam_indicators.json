{
  "version": "1.0.0",
  "model": "TF-IDF + Logistic Regression",
  "recommended_threshold": 0.45,
  "score_range": "0-100",
  "risk_bands": {
    "LOW": {
      "min": 0,
      "max": 30,
      "action": "allow",
      "color": "green"
    },
    "MEDIUM": {
      "min": 30,
      "max": 55,
      "action": "warn",
      "color": "yellow"
    },
    "HIGH": {
      "min": 55,
      "max": 75,
      "action": "alert",
      "color": "orange"
    },
    "CRITICAL": {
      "min": 75,
      "max": 100,
      "action": "block",
      "color": "red"
    }
  },
  "formula": "score = sum(matched_token_weights * category_multiplier) / normalization_factor",
  "normalization_factor": 3.5,
  "preprocessing_tokens": {
    "url_pattern": "URLTOKEN",
    "short_url_pattern": "SHORTURLTOKEN",
    "phone_pattern": "PHONETOKEN",
    "otp_pattern": "OTPTOKEN",
    "money_pattern": "MONEYTOKEN"
  },
  "indicators": {
    "urgency_phrases": {
      "description": "Words that create artificial urgency",
      "weight_multiplier": 1.3,
      "tokens": {
        "immediately": 72,
        "urgent": 78,
        "act now": 80,
        "final warning": 85,
        "last chance": 75,
        "expires today": 70,
        "within 2 hours": 82,
        "within 24 hours": 75,
        "do not ignore": 78,
        "respond now": 72,
        "limited time": 60,
        "tonight": 40,
        "expires": 52,
        "deadline": 55
      }
    },
    "authority_impersonation": {
      "description": "Fake government/bank authority claims",
      "weight_multiplier": 1.5,
      "tokens": {
        "cbi": 88,
        "cybercrime": 85,
        "cyber crime": 85,
        "income tax dept": 82,
        "trai": 80,
        "uidai": 72,
        "customs": 70,
        "court summons": 90,
        "legal action": 75,
        "warrant": 82,
        "arrest": 88,
        "police": 65,
        "officer": 60,
        "investigation": 70,
        "case filed": 78,
        "rbi": 55,
        "govt": 45
      }
    },
    "credential_payment_terms": {
      "description": "Requests for sensitive financial info",
      "weight_multiplier": 1.4,
      "tokens": {
        "otp": 70,
        "share otp": 92,
        "enter otp": 85,
        "kyc": 75,
        "kyc pending": 85,
        "kyc update": 82,
        "verify": 55,
        "verification": 52,
        "bank details": 80,
        "aadhaar": 60,
        "pan card": 55,
        "account number": 65,
        "transfer": 58,
        "refund": 50,
        "reward": 55,
        "claim": 52,
        "redeem": 55
      }
    },
    "threat_language": {
      "description": "Threatening consequences",
      "weight_multiplier": 1.4,
      "tokens": {
        "blocked": 65,
        "suspended": 68,
        "penalty": 72,
        "disconnected": 62,
        "permanently blocked": 82,
        "legal action": 75,
        "arrest": 88,
        "jail": 85,
        "overdue": 55,
        "frozen": 70,
        "cancelled": 48
      }
    },
    "url_patterns": {
      "description": "Suspicious link indicators",
      "weight_multiplier": 1.6,
      "tokens": {
        "URLTOKEN": 70,
        "SHORTURLTOKEN": 85,
        "click here": 72,
        "click now": 75,
        "bit.ly": 80,
        "tinyurl": 80,
        "t.me": 65,
        ".in/": 45,
        "-verify": 78,
        "-claim": 72,
        "-update": 65,
        "-secure": 68,
        "login": 55
      }
    },
    "prize_lottery": {
      "description": "Too-good-to-be-true offers",
      "weight_multiplier": 1.2,
      "tokens": {
        "won": 65,
        "winner": 70,
        "lucky draw": 82,
        "congratulations": 60,
        "selected": 52,
        "free gift": 70,
        "prize": 65,
        "lakh": 60,
        "crore": 62,
        "lottery": 78,
        "claim your": 68
      }
    },
    "financial_amounts": {
      "description": "Suspicious money requests",
      "weight_multiplier": 1.1,
      "tokens": {
        "MONEYTOKEN": 45,
        "pay now": 65,
        "pay immediately": 78,
        "fee": 42,
        "charge": 40,
        "deposit": 55,
        "investment": 50,
        "double": 65,
        "guaranteed returns": 82
      }
    },
    "negative_signals": {
      "description": "Tokens that strongly indicate legitimate messages (subtract from score)",
      "weight_multiplier": -1.0,
      "tokens": {
        "do not share": -80,
        "never share otp": -90,
        "sbi never asks": -85,
        "track": -30,
        "your order": -35,
        "delivery": -30,
        "appointment": -40,
        "confirmed": -25,
        "debited from": -20,
        "avl bal": -50,
        "epfindia.gov.in": -70,
        "irctc": -40
      }
    }
  }
}